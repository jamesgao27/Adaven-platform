{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@adaven/platform-core": ["../../packages/platform-core/src/index.ts"],
      "@adaven/platform-ui": ["../../packages/platform-ui/src/index.ts"],
      "@/lib/categories": ["./src/shared-logic/categories.ts"],
      "@/lib/*": ["./src/shared-logic/*"],
      "@/components/*": ["./src/mobile-ui/components/*"],
      "@/types": ["./src/shared-logic/types/index.ts"],
      "@/types/*": ["./src/shared-logic/types/*"],
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
