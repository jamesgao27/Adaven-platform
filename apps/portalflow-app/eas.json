        "APP_VARIANT": "receiptap"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {},
    "receiptap": {
      "ios": {
        "ascAppId": "6758536342"
      },
      "android": {
        "serviceAccountKeyPath": "/Users/macbook/Vouchap/vouchap-app/vouchap-f2d1043256dd.json",
        "track": "production"
      }
    }
  }
}
