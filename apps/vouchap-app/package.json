{
  "name": "vouchap-app",
  "version": "2.6.6",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go --lan",
    "start:lan": "expo start --dev-client --lan",
    "start:localhost": "expo start --dev-client --localhost",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:clear": "expo start --dev-client --clear",
    "web:clear": "expo start --web --clear",
    "web:export": "npx expo export -p web",
    "deploy:web": "npx expo export -p web && cp -f public/_redirects dist/_redirects && npx wrangler pages deploy dist --project-name=vouchap",
    "eas-build-pre-install": "cd ../.. && npm ci",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "verify:android:permissions": "node scripts/verify-android-media-permissions.js",
    "version:sync": "node scripts/sync-native-versions.js",
    "icons:sync-from-logo2": "bash scripts/sync-native-launcher-icons-from-logo2.sh",
    "build:android:production": "cd android && ./gradlew app:bundleRelease",
    "build:android:apk": "cd android && ./gradlew app:assembleRelease",
    "build:android:eas:local": "bash scripts/build-android-eas-local.sh"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@google/generative-ai": "^0.2.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/masked-view": "^0.1.11",
    "@supabase/supabase-js": "^2.39.0",
    "@xmldom/xmldom": "^0.8.11",
    "buffer": "^6.0.3",
    "date-fns": "^3.0.0",
    "@adaven/platform-core": "0.1.0",
    "@adaven/platform-ui": "0.1.0",
    "decimal.js": "^10.6.0",
    "docx-preview": "^0.3.7",
    "expo": "~54.0.31",
    "expo-av": "^16.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "^18.0.12",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.0",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-image-manipulator": "^14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "^8.0.11",
    "expo-router": "~6.0.22",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "jszip": "^3.10.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-document-scanner-plugin": "^2.0.4",
    "react-native-paper": "^5.11.3",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": ">=0.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.10",
    "typescript": "^5.1.3",
    "wrangler": "^4.67.0"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native-svg",
        "react-native-worklets"
      ]
    }
  }
}
